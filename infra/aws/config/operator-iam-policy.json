{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowUnscopableActions",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:CreateTags",
        "ec2:CreateVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:CreateInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:AllocateAddress",
        "ec2:CreateNatGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateRoute",
        "ec2:AssociateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateVpcEndpoint",
        "kms:ListAliases",
        "kms:CreateKey",
        "kms:CreateAlias",
        "kms:PutKeyPolicy",
        "kms:DescribeKey",
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion",
        "kms:GenerateDataKey",
        "kms:Decrypt",
        "kms:TagResource",
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:ListTaskDefinitions",
        "ecs:DescribeClusters",
        "ecs:DescribeServices",
        "ecs:DescribeTasks",
        "ecs:ListTasks",
        "logs:DescribeLogGroups",
        "cloudwatch:DescribeAlarms",
        "application-autoscaling:DescribeScalableTargets",
        "application-autoscaling:DescribeScalingPolicies",
        "application-autoscaling:DescribeScalingActivities",
        "application-autoscaling:RegisterScalableTarget",
        "application-autoscaling:DeregisterScalableTarget",
        "application-autoscaling:PutScalingPolicy",
        "application-autoscaling:DeleteScalingPolicy",
        "application-autoscaling:TagResource"
      ],
      "Resource": ["*"]
    },
    {
      "Sid": "AllowManageTaggedTestResources",
      "Effect": "Allow",
      "Action": [
        "ecr:*",
        "ecs:CreateCluster",
        "ecs:DeleteCluster",
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:GetTaskProtection",
        "s3:*",
        "sqs:*",
        "secretsmanager:*",
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteLogGroup",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "logs:TagResource",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource"
      ],
      "Resource": [
        "arn:aws:ecr:*:934167421030:repository/integrity-review-ecs-test-*",
        "arn:aws:ecs:*:934167421030:cluster/integrity-review-ecs-test-*",
        "arn:aws:ecs:*:934167421030:service/integrity-review-ecs-test-*/*",
        "arn:aws:ecs:*:934167421030:task/integrity-review-ecs-test-*/*",
        "arn:aws:sqs:*:934167421030:integrity-review-ecs-test-*",
        "arn:aws:secretsmanager:*:934167421030:secret:integrity-review-ecs-test/*",
        "arn:aws:logs:*:934167421030:log-group:/ecs/integrity-review-ecs-test-*",
        "arn:aws:logs:*:934167421030:log-group:/ecs/integrity-review-ecs-test-*:*",
        "arn:aws:cloudwatch:*:934167421030:alarm:integrity-review-ecs-test-*",
        "arn:aws:s3:::integrity-review-ecs-test*",
        "arn:aws:s3:::integrity-review-ecs-test*/*"
      ]
    },
    {
      "Sid": "AllowIamRoleManagementForTestRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:UpdateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:TagRole"
      ],
      "Resource": ["arn:aws:iam::934167421030:role/integrity-review-ecs-test-*"]
    },
    {
      "Sid": "AllowPassEcsRoles",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": [
        "arn:aws:iam::934167421030:role/integrity-review-ecs-test-ecs-execution",
        "arn:aws:iam::934167421030:role/integrity-review-ecs-test-ecs-task"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    },
    {
      "Sid": "AllowCreateEcsAutoscalingServiceLinkedRole",
      "Effect": "Allow",
      "Action": ["iam:CreateServiceLinkedRole"],
      "Resource": [
        "arn:aws:iam::*:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService"
      ],
      "Condition": {
        "StringEquals": { "iam:AWSServiceName": "ecs.application-autoscaling.amazonaws.com" }
      }
    },
    {
      "Sid": "AllowAssumeImagePublisher",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole"],
      "Resource": ["arn:aws:iam::*:role/integrity-review-ecs-test-image-publisher"]
    },
    {
      "Sid": "AllowCallerIdentityGuard",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": ["*"]
    }
  ]
}
